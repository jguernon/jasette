<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Le thème « Sombre » de Jasette : fond #1c1c1e avant que Compose dessine. -->
    <style name="Theme.Jasette" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fond</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Le partage : une fenêtre translucide, l'app d'origine assombrie derrière. -->
    <style name="Theme.Jasette.Partage" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>

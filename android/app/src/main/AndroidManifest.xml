<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Les ponts parlent à Google et à Meta. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Le service au premier plan garde les ponts vivants. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Les contacts du téléphone (photos, « Nouveau message ») : demandée seulement
         quand l'utilisateur en a besoin, jamais au démarrage. Ils ne quittent pas le téléphone. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- La mise à jour dans l'app (MiseAJour.kt) : installer l'APK release publié
         sur jonathanguernon.net/jasette, après vérification de son SHA-256 et de sa signature. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".JasetteApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Jasette"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jasette">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- Deux lanceurs, un par icône : les réglages activent l'un ou l'autre. -->
        <activity-alias
            android:name=".LanceurSombre"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Le partage direct : les conversations récentes (Raccourcis.kt). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".LanceurBlanc"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blanc"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Le partage direct : les conversations récentes (Raccourcis.kt). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- La Liste privée : sa propre activité, dans une tâche à part (l'icône
             normale ne la ramène pas), et son lanceur au cadenas, désactivé tant
             que la liste ne l'est pas (Prive.poserLanceur). -->
        <activity
            android:name=".PriveActivity"
            android:exported="false"
            android:taskAffinity="ca.jasette.prive"
            android:launchMode="singleTask"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
        <activity-alias
            android:name=".LanceurPrive"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_prive"
            android:label="Jasette privé"
            android:targetActivity=".PriveActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Le menu de partage d'Android : une fenêtre légère par-dessus l'app
             d'origine (PartageActivity), texte, liens, images, vidéos, sons et
             fichiers. Une tâche à part, hors des apps récentes : la fermer
             ramène l'app d'origine. -->
        <activity
            android:name=".PartageActivity"
            android:exported="true"
            android:label="Jasette"
            android:theme="@style/Theme.Jasette.Partage"
            android:taskAffinity="ca.jasette.partage"
            android:excludeFromRecents="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- L'appareil photo écrit ses photos et vidéos dans le cache de l'app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fichiers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fichiers" />
        </provider>

        <!-- Le statut de la session d'installation d'une mise à jour (MiseAJour.kt). -->
        <receiver
            android:name=".MiseAJourRecepteur"
            android:exported="false" />

        <service
            android:name=".PontService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
    </application>
</manifest>
